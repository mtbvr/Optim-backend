# Copier ce fichier en ".env" (jamais commite) et adapter les valeurs.

POSTGRES_DB=optdb
POSTGRES_USER=opt
POSTGRES_PASSWORD=change-me

# Cle HMAC pour signer les JWT : minimum 32 caracteres aleatoires.
# Generer par exemple avec : openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-32chars-min
JWT_EXPIRATION_MINUTES=60

# true uniquement si le site est servi en HTTPS (sinon le navigateur rejette le cookie)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
